---
import Layout from '../layouts/Layouts.astro';

const contactInfo = [
  { method: "Adresse", details: "123 Rue du Bien-Être, Le Plessis Robinson" },
  { method: "Téléphone", details: "+33 1 23 45 67 89" },
  { method: "Email", details: "contact@johannechieu.fr" },
  { method: "Horaires", details: "Lundi - Vendredi : 9h - 18h" }
];
---

<Layout 
  title="Contact | Johanne Chieu - Sophrologue"
  description="Contactez Johanne Chieu pour toute demande de rendez-vous ou de renseignement sur les séances de sophrologie."
>
  <!-- Header Section -->
  <div class="relative py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-light mb-4">Contactez-moi</h1>
      <p class="text-lg text-gray-600 mb-8">
        Pour toute demande de rendez-vous, d’information sur mes séances ou mes services, n’hésitez pas à me contacter via le formulaire ou par téléphone.
      </p>
    </div>
  </div>

  <!-- Contact Information Section -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-light mb-8">Informations de Contact</h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 text-center">
        {contactInfo.map(info => (
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <h3 class="text-teal-600 font-semibold mb-2">{info.method}</h3>
            <p class="text-gray-600">{info.details}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact Form Section -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-light mb-8">Envoyez-moi un message</h2>
      <form action="/send-message" method="POST" class="space-y-6">
        <div>
          <label for="name" class="block text-gray-600 mb-2">Nom complet</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-teal-500 focus:border-teal-500"
          />
        </div>
        <div>
          <label for="email" class="block text-gray-600 mb-2">Adresse email</label>
          <input 
            type="email" 
            id="email" 
            name="email" 
            required 
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-teal-500 focus:border-teal-500"
          />
        </div>
        <div>
          <label for="message" class="block text-gray-600 mb-2">Message</label>
          <textarea 
            id="message" 
            name="message" 
            rows="6" 
            required 
            class="w-full p-3 border border-gray-300 rounded-lg focus:ring-teal-500 focus:border-teal-500"
          ></textarea>
        </div>
        <div>
          <button 
            type="submit" 
            class="w-full px-6 py-3 bg-teal-600 text-white font-semibold rounded-lg hover:bg-teal-700 transition-colors duration-300"
          >
            Envoyer le message
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Map and Practical Information -->
  <section class="py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-light mb-8">Plan d'accès</h2>
      <div class="relative h-80 mb-8">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2625.1969472172813!2d2.2598335156749886!3d48.79325787928085!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47e67c85d92a5e71%3A0x18d5c60bfe5f260d!2sLe%20Plessis-Robinson!5e0!3m2!1sfr!2sfr!4v1645623609263!5m2!1sfr!2sfr" 
          width="100%" 
          height="100%" 
          style="border:0;" 
          allowfullscreen="" 
          loading="lazy" 
          title="Carte d'accès au cabinet"
        ></iframe>
      </div>
      <p class="text-center text-gray-600">
        Mon cabinet se situe dans un quartier calme et accessible, idéal pour vous accueillir dans un espace de bien-être.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* Custom Styles */
  .text-center { text-align: center; }
</style>
