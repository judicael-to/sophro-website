---
import Layout from '../layouts/Layouts.astro';

const tarifs = [
  { title: "Séance individuelle", price: "60€" },
  { title: "Séance de groupe", price: "40€" },
  { title: "Séance en visio", price: "50€" },
];

const informations = [
  { title: "Prise en charge mutuelle", description: "Certaines mutuelles remboursent partiellement les séances de sophrologie. Renseignez-vous auprès de votre assureur." },
  { title: "Contre-indications", description: "Les séances de sophrologie ne remplacent pas un suivi médical. Elles sont déconseillées en cas de psychose sévère." },
];
---

<Layout 
  title="Modalités pratiques | Johanne Chieu - Sophrologue"
  description="Découvrez les informations pratiques sur le déroulement des séances, les tarifs et les modalités de prise en charge."
>
  <!-- Hero Section -->
  <div class="relative py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-light mb-6">Modalités pratiques</h1>
      <p class="text-lg text-gray-600">
        Retrouvez toutes les informations nécessaires pour organiser vos séances : déroulement, tarifs et prise en charge.
      </p>
    </div>
  </div>

  <!-- Déroulement des séances -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-light mb-8">Déroulement des séances</h2>
      <div class="prose prose-lg max-w-none text-gray-600">
        <p>
          Chaque séance commence par un échange pour identifier vos besoins et adapter la pratique. Elle se poursuit par des exercices de respiration, de relaxation, et de visualisation, pour favoriser votre bien-être et renforcer votre équilibre intérieur.
        </p>
        <p>
          En moyenne, cinq à huit séances sont nécessaires pour observer des progrès significatifs, mais le rythme est adapté à votre évolution et disponibilité.
        </p>
      </div>
    </div>
  </section>

  <!-- Tarifs -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-light mb-8">Tarifs</h2>
      <div class="grid md:grid-cols-2 gap-8">
        {tarifs.map(tarif => (
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <p class="font-medium">{tarif.title}</p>
            <p class="text-teal-600 text-lg font-semibold">{tarif.price}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Informations pratiques -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-light mb-8">Informations pratiques</h2>
      <div class="space-y-6 text-gray-600">
        {informations.map(info => (
          <div class="bg-gray-100 p-6 rounded-lg shadow-sm">
            <h3 class="text-xl font-medium text-teal-600 mb-2">{info.title}</h3>
            <p>{info.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-teal-600 text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl mb-6">Besoin de plus d'informations ?</h2>
      <p class="mb-8 text-lg">
        N'hésitez pas à me contacter pour toute question ou pour planifier une première séance découverte.
      </p>
      <a 
        href="/contact" 
        class="inline-block px-8 py-4 bg-white text-teal-600 rounded-full hover:bg-gray-100 transition-colors duration-300"
      >
        Contactez-moi
      </a>
    </div>
  </section>
</Layout>

<style>
  .prose p {
    line-height: 1.8;
  }
</style>
