---
import Layout from '../layouts/Layouts.astro';
---

<Layout
  title="Sophrologie | Johanne Chieu - Mentions légales"
>

  <div class="relative pt-32 pb-16 bg-gradient-to-b from-fuchsia-100 to-blue-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-light mb-6">Qu'est-ce que la Sophrologie</h1>
      <p class="text-lg text-gray-600">
          Elle consiste à vivre la vie qui est en soi, à l'activer pour développer ses
          compétences, ses valeurs et son potentiel, en vue d'être davantage soi-même et de se
          redéployer pour exister positivement.
      </p>
    </div>
  </div>

  
  <section class="p-0 md:py-24 bg-gradient-to-t from-pink-200 to-blue-200">
    
  </section>

</Layout>