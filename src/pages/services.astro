---
import Layout from '../layouts/Layouts.astro';

const contactInfo = [
  { method: "Adresse", details: "123 Rue du Bien-Être, Le Plessis Robinson" },
  { method: "Téléphone", details: "+33 1 23 45 67 89" },
  { method: "Email", details: "contact@johannechieu.fr" },
  { method: "Horaires", details: "Lundi - Vendredi : 9h - 18h" }
];
---

<Layout 
  title="Contact | Johanne Chieu - Sophrologue"
  description="Contactez Johanne Chieu pour toute demande de rendez-vous ou de renseignement sur les séances de sophrologie."
>
  <!-- Header Section -->
  <section class="bg-gray-100 py-12">
    <div class="container mx-auto px-6">
      <!-- Titre principal de la page -->
      <h1 class="text-3xl font-bold text-gray-800 mb-8">Nos Services</h1>
      
      <!-- Bloc 1 : Accompagnements individuels -->
      <section>
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Accompagnements individuels</h2>
        <p class="text-gray-600 mb-6">Des accompagnements adaptés pour soutenir le bien-être individuel.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">CACA</h3>
            <p class="text-gray-600">Aidez-vous à réduire le stress grâce à des méthodes adaptées.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Confiance en soi</h3>
            <p class="text-gray-600">Renforcez votre confiance pour mieux avancer dans la vie.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Préparation aux événements</h3>
            <p class="text-gray-600">Optimisez votre préparation mentale pour des événements importants.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Sommeil</h3>
            <p class="text-gray-600">Améliorez la qualité de votre sommeil de manière naturelle.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Maternité</h3>
            <p class="text-gray-600">Un soutien personnalisé pendant la période de maternité.</p>
          </div>
        </div>
      </section>
  
      <!-- Bloc 2 : Techniques spécifiques -->
      <section class="mt-12">
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Techniques spécifiques</h2>
        <p class="text-gray-600 mb-6">Des méthodes éprouvées pour améliorer le bien-être.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-4 rounded-lg shadow">

            <h3 class="text-lg font-semibold text-gray-600">Sophrologie</h3>
            <p class="text-gray-600">Explorez les bienfaits de la sophrologie.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">

            <h3 class="text-lg font-semibold text-gray-600">Respiration</h3>
            <p class="text-gray-600">Apprenez des techniques de respiration pour plus de sérénité.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">

            <h3 class="text-lg font-semibold text-gray-600">Cohérence cardiaque</h3>
            <p class="text-gray-600">Maitrisez la cohérence cardiaque pour gérer votre stress.</p>
          </div>

        </div>
      </section>
  
      <!-- Bloc 3 : Accompagnement professionnel -->
      <section class="mt-12">
        <h2 class="text-2xl font-semibold text-gray-700 mb-4">Accompagnement professionnel</h2>
        <p class="text-gray-600 mb-6">Des programmes adaptés aux besoins professionnels.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Entreprises</h3>
            <p class="text-gray-600">Accompagnement sur mesure pour le bien-être en entreprise.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Milieu hospitalier</h3>
            <p class="text-gray-600">Des outils pour les professionnels de la santé.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Sportifs</h3>
            <p class="text-gray-600">Accompagnement spécifique pour les athlètes.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Artistes</h3>
            <p class="text-gray-600">Optimisez votre performance artistique grâce à nos méthodes.</p>
          </div>
          <div class="bg-white p-4 rounded-lg shadow">
            <h3 class="text-lg font-semibold text-gray-800">Scolaire</h3>
            <p class="text-gray-600">Soutien pour étudiants et enseignants.</p>
          </div>
        </div>
      </section>
    </div>
  </section>
  
</Layout>
