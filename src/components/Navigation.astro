---
// src/components/Navigation.astro
const menuItems = [
  {
    title: "Services",
    path: "/services",
  },
  {
    title: "À propos",
    path: "/about",
  },
  {
    title: "Modalités",
    path: "/modalities",
  },
  {
    title: "Contact",
    path: "/contact",
  },
];
---

<nav class="bg-white shadow-lg fixed w-full z-50">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex justify-between">
      <div class="flex space-x-7">
        <div>
          <a href="/" class="flex items-center py-4">
            <img src="/logo-sophrologue.svg" alt="Logo" class="h-16 w-auto mr-2">
            <span class="font-semibold text-gray-700 text-lg">Johanne Chieu</span>
          </a>
        </div>

        <!-- Navigation principale - Desktop -->
        <div class="hidden md:flex items-center space-x-1">
          {menuItems.map(item => (
            <div class="relative group">
              <a
                href={item.path}
                class="py-4 px-3 text-gray-700 hover:text-teal-600 transition duration-300"
              >
                {item.title}
              </a>
            </div>
          ))}
        </div>
      </div>

      <!-- Bouton RDV -->
      <div class="hidden md:flex items-center">
        <a
          href="/contact"
          class="px-4 py-2 bg-teal-600 text-white rounded-full hover:bg-teal-700 transition duration-300"
        >
          Prendre RDV
        </a>
      </div>

      <!-- Bouton Mobile -->
      <div class="md:hidden flex items-center">
        <button class="mobile-menu-button" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu Mobile -->
  <div class="mobile-menu hidden md:hidden">
    <div class="px-2 pt-2 pb-3 space-y-1">
      {menuItems.map(item => (
        <div>
          <a
            href={item.path}
            class="block px-3 py-2 text-gray-700 hover:bg-teal-50 hover:text-teal-600 transition duration-300"
          >
            {item.title}
          </a>
        </div>
      ))}
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.querySelector('.mobile-menu-button');
  const mobileMenu = document.querySelector('.mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>