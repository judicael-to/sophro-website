---
import Layout from '../layouts/Layouts.astro';

const tarifs = [
  { title: "Séance individuelle"},
  { title: "Séance de groupe"},
  { title: "Séance en visio"},
];

const informations = [
  { title: "Prise en charge mutuelle", description: "Certaines complémentaires santé remboursent partiellement les séances de sophrologie. Renseignez-vous auprès de votre assureur." },
  { title: "Contre-indications", description: "La sophrologie ne se substitue pas aux traitements et suivis médicaux." },
];
---

<Layout 
  title="Modalités | Johanne Chieu - Sophrologue"
  description="Découvrez les informations pratiques sur le déroulement des séances, les tarifs et les modalités de prise en charge."
>
  <!-- Hero Section -->
  <div class="relative pt-32 pb-16 bg-gradient-to-b from-fuchsia-100 to-blue-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-light mb-6">Modalités pratiques</h1>
      <p class="text-lg text-gray-600">
        Retrouvez toutes les informations nécessaires pour organiser vos séances : déroulement, tarifs et prise en charge.
      </p>
    </div>
  </div>

  <!-- Déroulement des séances -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-light mb-8">Déroulement des séances</h2>
        <div class="bg-blue-50 shadow mt-4 p-6 rounded-lg">  
          <h3 class="text-2xl text-blue-400 font-light mb-4">Première séance :</h3>
          <div class="prose prose-lg max-w-none text-gray-600">
            <ul class="list-disc ml-10">
              <li>Un temps d’écoute de vos besoins d’accompagnement, du problème rencontré
                  (respiration, stress, gestion des émotions, confiance, concentration, sommeil,
                  lassitude, énergie et force, douleur chronique…)</li>
              <li>Une petite présentation sur la sophrologie appliquée au thème
                  d’accompagnement.</li>
              <li>Pratique, une séance de découverte de la sophrologie.</li>
              <li>Un temps de partage des impressions, afin de suivre votre progression.</li>
            </ul>
          </div>
        </div>
        <div class="bg-blue-50 shadow mt-8 p-6 rounded-lg">
          <h3 class="text-2xl text-blue-400 font-light mb-4">Deuxième séance :</h3>
          <div class="prose prose-lg max-w-none text-gray-600">
            <ul class="list-disc ml-10">
              <li>Un temps d’écoute de vos ressentis en rapport avec vos pratiques personnelles
                  des techniques et outils appris lors de la séance précédente.</li>
              <li>Proposition d’un parcours d’accompagnement adapté.</li>
              <li>Le rythme des séances est à définir en fonction de vos disponibilités et de vos
                  besoins. L’espacement entre deux séances est en principe d’une semaine, dix
                  jours, deux semaines.</li>
              <li>Ce protocole peut évoluer au fil de vos pratiques personnelles et en séance.</li>
              <li>En moyenne cinq à huit séances sont nécessaires. Vous pouvez décider
                  d’arrêter ou d’espacer vos séances.</li>
              <li>Pratique d’une technique enregistrée.</li>
              <li>Un temps de partage des impressions, afin de suivre votre progression.</li>
            </ul>
          </div>
        </div>
    </div>
  </section>

  <!-- Tarifs -->
  <section class="py-16 bg-gray-100">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-light mb-8 text-blue-400">Tarifs</h2>
      <div class="pb-8 grid md:grid-cols-2 gap-8">
        <div>  
          <div class="bg-white p-6 rounded-lg shadow-sm">
              <p class="text-2xl font-medium">Séance individuelle</p>
              <p class="pb-4 text-gray-500">En présentiel ou visioconférence</p>
              <p class="text-xl">Adulte</p>
              <p class="pb-2">60 € la séance d’1 heure</p>
              <p class="text-xl">Adolescent</p>
              <p class="pb-2">45 € la séance de 45 minutes</p>
              <p class="text-xl">Etudiant</p>
              <p>250 € un forfait de 5 séances d’1 heure</p>
          </div>
        </div>
        <div>
          <div class="bg-white p-6 rounded-lg shadow-sm">
            <p class="text-2xl font-medium">Séance de groupe</p>
            <p class="pb-4 text-gray-500">3 personnes minimum</p>
            <p class="text-xl">Adulte</p>
            <p class="pb-2">25 € par personne la séance d’1 heure</p>
          </div>
        </div>
      </div>
      <p class="text-center text-gray-500">
        Règlement par CB ou en espèces, pour les séances en visioconférence le paiement par
        virement bancaire sera demandé avant le jour du rendez-vous.
      </p>
    </div>
  </section>

  <!-- Informations pratiques -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-light mb-8">Informations pratiques</h2>
      <div class="space-y-6 text-gray-600">
        {informations.map(info => (
          <div class="bg-gray-50 p-6 rounded-lg shadow">
            <h3 class="text-xl font-medium text-blue-400 mb-2">{info.title}</h3>
            <p>{info.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-t from-purple-300 to-blue-300 text-white">
    <div class="md:flex">
      <div class="ml-16">
        <img class="w-50 h-20 mb-6" src="/images/LOGO-SSI.jpg" alt="LOGO SSI">
        <img class="w-50 h-20" src="/images/LOGO-Annuaire-des-Pros-SSI.png" alt="LOGO Annuaires des Pros">
      </div>
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl mb-6">Besoin de plus d'informations ?</h2>
        <p class="mb-8 text-lg">
          N'hésitez pas à me contacter pour toute question ou pour planifier une première séance découverte.
        </p>
        <a 
          href="/contact" 
          class="inline-block px-8 py-4 bg-white text-blue-400 rounded-full hover:bg-gray-100 transition-colors duration-300"
        >
          Contactez-moi
        </a>
      </div>
      <div>
        <img class="w-42 h-24 mr-16" src="/images/Affichage-Mediateur-de-la-consommation.jpg" alt="Affichage Médiateur de laconsommation">
      </div>
      <div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .prose p {
    line-height: 1.8;
  }
</style>
